    {
      "id": "JSON_NULL_IS_NOT_STRING_NULL",
      "kind": "Source semantics; correction to initial verbal description",
      "status": "Resolved in checked derived run: JSON nulls are preserved; anomaly summary distinguishes null values from literal strings.",
      "evidence": {
        "groupId": "11",
